{
  "id": "UI_CREATE_EMPLOYEE_003",
  "name": "Kiểm tra mở form Thêm mới nhân sự, nhập liệu và đóng drawer",
  "description": "Nhấp nút 'Thêm nhân viên mới', xác minh Drawer mở, nhập các thông tin nhân sự và bấm Hủy bỏ để đóng form an toàn",
  "type": "ui",
  "module": "Quản lý Nhân sự",
  "priority": "critical",
  "tags": ["create", "employees", "drawer"],
  "startUrl": "/employees",
  "steps": [
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": "Thêm nhân viên mới"
      },
      "description": "Nhấp mở Drawer 'Thêm nhân viên mới'"
    },
    {
      "action": "assertVisible",
      "target": {
        "text": "Thêm mới nhân viên"
      },
      "description": "Xác minh tiêu đề Drawer 'Thêm mới nhân viên' hiển thị"
    },
    {
      "action": "fill",
      "target": {
        "placeholder": "Nhập họ và tên"
      },
      "value": "Nguyễn Hoàng Nam",
      "description": "Nhập họ và tên nhân viên: Nguyễn Hoàng Nam"
    },
    {
      "action": "fill",
      "target": {
        "placeholder": "Nhập mã nhân viên"
      },
      "value": "EMP-999",
      "description": "Nhập mã nhân viên: EMP-999"
    },
    {
      "action": "fill",
      "target": {
        "placeholder": "Nhập email công ty"
      },
      "value": "nam.nh@hrm.vn",
      "description": "Nhập email công ty: nam.nh@hrm.vn"
    },
    {
      "action": "fill",
      "target": {
        "placeholder": "Nhập số điện thoại"
      },
      "value": "0987654321",
      "description": "Nhập số điện thoại: 0987654321"
    },
    {
      "action": "fill",
      "target": {
        "placeholder": "Nhập chức danh / vị trí"
      },
      "value": "QA Automation Lead",
      "description": "Nhập chức danh: QA Automation Lead"
    },
    {
      "action": "fill",
      "target": {
        "placeholder": "Nhập mức lương cơ bản"
      },
      "value": "35000000",
      "description": "Nhập mức lương: 35000000"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": "Hủy bỏ"
      },
      "description": "Nhấp nút 'Hủy bỏ' để đóng Drawer"
    },
    {
      "action": "assertVisible",
      "target": {
        "text": "Quản lý Nhân viên"
      },
      "description": "Xác minh quay lại màn hình danh sách Quản lý Nhân viên"
    }
  ]
}
