      "headers": {
        "Authorization": "Bearer {{TOKEN_C2}}",
        "Content-Type": "application/json"
      },
      "assertions": [
        {
          "type": "status",
          "expected": 200,
          "description": "Tài khoản C2 có quyền xem danh sách cảng cạn (mã 200)"
        }
      ]
    },
    {
      "name": "Đăng nhập với tài khoản C3 (testhh1@gmail.com)",
