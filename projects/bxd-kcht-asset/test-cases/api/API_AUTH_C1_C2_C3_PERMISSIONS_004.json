        }
      ],
      "assertions": [
        {
          "type": "status",
          "expected": 200,
          "description": "Tài khoản C2 đăng nhập thành công mã 200"
        },
        {
          "type": "fieldExists",
          "path": "data.token",
          "description": "Phải nhận được Token JWT cho tài khoản C2"
        }
      ]
    },
    {
      "name": "Tài khoản C2 gọi API danh sách Cảng cạn",
